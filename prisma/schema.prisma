generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Member {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  discordId     String   @unique
  name          String   @map("nome")
  role          String   @default("Membro AFL") @map("cargo")
  panelRole     String?  @map("cargoPainel")
  avatar        String?  @map("avatar")
  sales         Float    @default(0) @map("vendas")
  receivedValue Float    @default(0) @map("valorRecebido")
  recruitments  Int      @default(0) @map("recrutamentos")
  extraCashback Float    @default(0) @map("cashbackExtra")
  paidCashback  Float    @default(0) @map("cashbackPago")
  updatedAt     DateTime @updatedAt @map("atualizado_em")

  @@map("Membro")
}

model Record {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   @map("nome")
  discordId         String
  type              String   @map("tipo")
  client            String?  @map("cliente")
  document          String?  @map("cpfEmail")
  item              String?
  paymentMethod     String?  @map("valorPagamento")
  advancedDiscordId String?  @map("idDiscordAvancado")
  amount            Float?   @map("valor")
  receivedAmount    Float?   @map("valorRecebido")
  extraCashback     Float?   @map("cashbackExtra")
  dueDate           String?  @map("dataVencimento")
  recruitedId       String?  @map("recrutadoId")
  quantity          Int?     @map("quantidade")
  status            String   @default("PENDENTE")
  createdBy         String?  @map("criadoPor")
  evaluatedBy       String?  @map("avaliadoPor")
  createdAt         DateTime @default(now()) @map("criado_em")

  @@map("Registro")
}